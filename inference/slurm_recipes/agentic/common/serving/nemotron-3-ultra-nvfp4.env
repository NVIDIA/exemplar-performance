# shellcheck shell=bash
# shellcheck disable=SC2034 # every variable here is read by the script that sources this file
#
# The vLLM server the gpu recipes run for the nemotron-3-ultra-nvfp4 trajectories, sourced by
# common/tasktrace_gpu_lib.sh (llm_server_load_config <name>; <name> is this file's stem). Mirrors
# the k8s GPU TaskTrace cells (inference/k8s_recipes/recipes/agentic/*/swebench-verified-gb300-gpu): same
# repository and revision, TP4, native context, same flags, same start-up allowance.

SERVING_NAME="nemotron-3-ultra-nvfp4"
SERVING_ENGINE="vllm"

# Must match downloads.huggingface.repos in the GPU recipes' metadata.
SERVING_MODEL_REPO="nvidia/NVIDIA-Nemotron-3-Ultra-550B-A55B-NVFP4"
SERVING_MODEL_REVISION="183968f87ae4cedce3039313cac1fd43d112c578"
SERVING_MODEL_DIR_NAME="NVIDIA-Nemotron-3-Ultra-550B-A55B-NVFP4"

SERVING_SERVED_MODEL_NAME="nemotron-3-ultra-nvfp4"

# Must match container.images in the GPU recipes' metadata.
SERVING_IMAGE_REF="nvcr.io#nvidia/ai-dynamo/vllm-runtime:sha256:9fefbd10b63c52030326e22ed0eb9d87082fee53709fe327b5b2773e267792bc"

SERVING_TP=4
SERVING_MAX_MODEL_LEN=262144
SERVING_GPU_MEM_UTIL=0.90
SERVING_STARTUP_TIMEOUT_SEC=1800 # cold load of the 550B NVFP4 weights from the shared filesystem

SERVING_ENV=(
    HF_HUB_OFFLINE=1
    TRANSFORMERS_OFFLINE=1
    VLLM_ATTENTION_BACKEND=FLASHINFER
    VLLM_ALLOW_LONG_MAX_MODEL_LEN=1
    PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
)

# Extra vllm.entrypoints.openai.api_server arguments, one word per element.
SERVING_EXTRA_ARGS=(
    --disable-custom-all-reduce
    --enable-expert-parallel
    --kv-cache-dtype fp8
    --mamba-ssm-cache-dtype float16
    --enable-chunked-prefill
    --enable-prefix-caching
    --enable-prompt-tokens-details # cached prompt tokens in every usage record, for the capture and the replay
    --tool-call-parser qwen3_coder
    --reasoning-parser nemotron_v3
    --enable-auto-tool-choice
    --override-generation-config '{"temperature": 1.0, "top_p": 0.95}'
)
