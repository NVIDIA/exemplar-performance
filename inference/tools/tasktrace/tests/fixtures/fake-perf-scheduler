"""Stable fake `perf` executable for Rust scheduler-control tests."""

import os
import signal
import sys


mode = sys.argv[1]
if mode == "version":
    print("perf version fake-test")
    raise SystemExit(0)
if mode == "script":
    print(
        "task 42/42 [000] 1.100000000: "
        "PERF_RECORD_SWITCH_CPU_WIDE IN prev pid/tid: 0/0"
    )
    print(
        "task 42/42 [000] 1.300000000: "
        "PERF_RECORD_SWITCH_CPU_WIDE OUT next pid/tid: 0/0"
    )
    raise SystemExit(0)
if mode != "record":
    raise SystemExit(43)

arguments = sys.argv[2:]
control = arguments[arguments.index("--control") + 1]
output = arguments[arguments.index("-o") + 1]
with open(output, "wb") as handle:
    handle.write(b"fake perf data\n")
control_read, ack_write = (
    int(value) for value in control.removeprefix("fd:").split(",")
)


def read_action(fd: int) -> bytes:
    value = b""
    while not value.endswith(b"\n"):
        chunk = os.read(fd, 4096)
        if not chunk:
            raise SystemExit(40)
        value += chunk
    return value.strip()


signal.signal(signal.SIGINT, lambda _signal, _frame: sys.exit(0))
signal.signal(signal.SIGTERM, lambda _signal, _frame: sys.exit(0))
if read_action(control_read) != b"enable":
    raise SystemExit(41)
os.write(ack_write, b"\0ack\n")
if read_action(control_read) != b"disable":
    raise SystemExit(42)
os.write(ack_write, b"\0ack\n")
while True:
    signal.pause()
