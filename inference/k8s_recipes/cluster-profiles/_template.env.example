# Cluster settings used when rendering and running recipes.
#
#   scripts/llmb-k8s init --cluster my-cluster    # recommended: generate a profile with the setup wizard
#   # or create one manually
#   cp _template.env.example my-cluster.env      # real *.env are gitignored; only *.env.example is tracked
#   $EDITOR my-cluster.env                        # replace every <PLACEHOLDER>
#   scripts/deploy.sh <cell-dir> my-cluster       # renders rendered/ with these vars + kubectl apply
#
# The renderer substitutes these values into manifests at launch. Keep cluster-specific values here instead of in recipes.

# ----- Identity ------------------------------------------------------------
CLUSTER="<your-cluster-name>"            # matches this filename (<CLUSTER>.env); diagnostics only
NAMESPACE="<your-namespace>"             # recipe resources land here (`llmb-k8s install` creates it idempotently)
OWNER="<your-username>"                  # stamped on resource labels (optional; defaults to $(whoami))
# Set KUBE_CONTEXT when you use more than one cluster. If it is empty, commands use the current kubectl context.
KUBE_CONTEXT=""                          # e.g. example-gpu-cluster-cluster
# Optional command shown by `llmb-k8s fleet` when cluster authentication has expired.
#   CONNECT_CMD="<your-cluster-login-command>"
CONNECT_CMD=""

# ----- GPU scheduling ------------------------------------------------------
# GPU_PRODUCT must match the `nvidia.com/gpu.product` label on eligible nodes.
GPU_PRODUCT="<gpu-product-label>"        # e.g. NVIDIA-B200 / NVIDIA-GB200 / NVIDIA-GB300
# GPU_PER_NODE is the number of GPUs on one eligible node. Whole-node recipes request
# `nvidia.com/gpu: ${GPU_PER_NODE}` so it can only land on a node it fully occupies. Discover with:
#   kubectl get nodes -l nvidia.com/gpu.product=$GPU_PRODUCT \
#     -o jsonpath='{.items[0].status.allocatable.nvidia\.com/gpu}'
GPU_PER_NODE="<gpus-per-node>"           # e.g. 8 (B200 nodes) / 4 (GB300 nodes)
# CPU_PER_NODE and MEM_PER_NODE are the smallest allocatable values across eligible GPU nodes. The setup wizard detects them automatically. To inspect them manually:
#   kubectl get nodes -l nvidia.com/gpu.product=$GPU_PRODUCT \
#     -o jsonpath='{.items[0].status.allocatable.cpu}{"  "}{.items[0].status.allocatable.memory}'
CPU_PER_NODE="<cpu-millicores>"          # allocatable CPU, in millicores
MEM_PER_NODE="<mem-gib>"                 # allocatable memory, rounded down to whole Gi
# Whole-node recipes request 85% of allocatable CPU and memory, leaving room for cluster services.
# WHOLE_NODE_CPU is an integer core count, without the `m` suffix.
WHOLE_NODE_CPU="<whole-cores>"           # floor(CPU_PER_NODE × 85% / 1000)
WHOLE_NODE_MEM="<mem-gib>"               # floor(MEM_PER_NODE × 85%)
# ARCH is the node CPU arch (kubernetes.io/arch). Optional — used by the target-compat gate + as a hint.
ARCH="<amd64|arm64>"                     # B200 = amd64 · GB200/GB300 (Grace) = arm64
# GPU_TYPE (optional): override the recipe-match target if GPU_PRODUCT isn't the standard NVIDIA-<X> form.
# The default scheduler supports device-plugin GPU resources.
# Use a different scheduler only when your cluster requires it.
# Use a gang scheduler name only if yours refuses device-plugin GPUs on DRA nodes.
SCHEDULER_NAME="default-scheduler"

# ----- Image registry ------------------------------------------------------
# Name of an existing docker-registry Secret in NAMESPACE. Leave a harmless placeholder for public images.
IMAGE_PULL_SECRET="<pull-secret-name>"

# ----- Model and dataset cache ---------------------------------------------
# Set cache claim names in the profile. The installer and serving manifests use the same resolved claim.
#
# MODEL_CACHE_PVC is required. Use `llmb-k8s install <cluster> --adopt-cache` to discover existing model claims.
#
# Add a per-model override when a model uses a different claim. Convert its model name to uppercase and replace non-alphanumeric characters with underscores:
#   MODEL_CACHE_PVC="shared-model-cache"
#   MODEL_CACHE_PVC_EXAMPLE_MODEL="dedicated-model-cache"
#
# Configure storage classes for shared ReadWriteMany and single-node ReadWriteOnce claims. The installer selects the class required by each recipe.
#   MODEL_CACHE_RWX_CLASS — a ReadWriteMany class (FSx/EFS/Filestore/Azure Files/Ceph-NFS). Used by
#                           disaggregated / multi-worker recipes (access_mode: rwx).
#   MODEL_CACHE_RWO_CLASS — a ReadWriteOnce block class (EBS/PD/managed-csi). Used by single-node recipes
#                           (access_mode: rwo, e.g. a KVBM colocated offload cache).
# Leave a class empty to fall through to the cluster's default StorageClass for that access mode.
MODEL_CACHE_RWX_CLASS="<rwx-storage-class>"   # e.g. efs-sc / <fsx-lustre-class>
MODEL_CACHE_RWO_CLASS="<rwo-storage-class>"   # e.g. ebs / gp3 / standard-rwo / managed-csi
#
# ----- Cache claims --------------------------------------------------------
# MODEL_CACHE_SUBPATH is the path WITHIN the cache to the HuggingFace root (the dir holding
# hub/models--<org>--<name>/); "." = PVC root is HF root.
MODEL_CACHE_PVC="<model-cache-pvc>"          # REQUIRED — the claim every model uses unless overridden below
MODEL_CACHE_SUBPATH="."                      # set to "." if PVC root = HF cache root

# Uncomment a per-model key only when that model uses a different claim. `--adopt-cache` can write these mappings.
# MODEL_CACHE_PVC_EXAMPLE_MODEL="dedicated-model-cache"

# Set MODEL_CACHE_NODE_SELECTOR when the storage driver can mount the cache only on selected nodes. Empty allows any node.
# Same inline-YAML syntax as BENCH_NODE_SELECTOR below.
MODEL_CACHE_NODE_SELECTOR=""                 # e.g. 'nvidia.com/gpu.present: "true"'
# Trace benchmark pods mount the cache for their dataset, so their selector must also choose a mountable node.
# MODEL_CACHE_SIZE="20Gi"                                   # optional back-compat single-cache size
# MODEL_CACHE_STORAGE_CLASS=""                              # optional back-compat single-cache class
# MODEL_CACHE_ACCESS_MODE=""                                # optional: ReadWriteOnce | ReadWriteMany

# ----- Secrets (referenced by name, never embedded) ------------------------
HF_SECRET="hf-token-secret"              # name of a Secret holding the HF token (used by download jobs)

# ----- Bench pod placement -------------------------------------------------
# nodeSelector key=value pair for the CPU-only bench pod. Set this to keep the bench pod off
# GPU nodes (an empty value means "schedule anywhere", which can consume a GPU node slot).
# Examples:
#   BENCH_NODE_SELECTOR="node-role.kubernetes.io/worker: \"true\""   # any non-GPU node
#   BENCH_NODE_SELECTOR="kubernetes.io/arch: amd64"                   # amd64 CPU nodes
# Leave empty only if your cluster has no dedicated CPU nodes and GPU pods tolerate co-location.
BENCH_NODE_SELECTOR=""
BENCH_CPU_REQUEST="16"

# ----- Artifacts (per-run bench output; ReadWriteOnce is fine) -------------
# Choose a size that accommodates the expected number of rungs and retained artifacts. The default is a
# starting point; increase it when runs retain larger inputs or additional diagnostics.
ARTIFACTS_STORAGE_CLASS="<rwo-storage-class>"   # e.g. gp3 / standard-rwo / managed-csi
ARTIFACTS_SIZE="20Gi"

# ----- Control plane (disconnect-resilient `submit`; ReadWriteMany REQUIRED) -----
# CONTROL_STORAGE_CLASS must provide ReadWriteMany access so detached-run state can be read concurrently.
# Bulk results remain on the artifacts PVC. Profile validation checks this capability.
CONTROL_STORAGE_CLASS="<rwx-storage-class>"     # e.g. standard-rwx / efs-sc / <fsx-lustre-class>
CONTROL_SIZE="5Gi"

# ----- RDMA / InfiniBand fabric (DISAGG recipes only) ----------------------
# Configure these values for disaggregated recipes that use RDMA. Aggregated recipes do not need them.
# Keep NIC names and transport settings in the cluster profile so recipes remain portable.
#
# Run `llmb-k8s profile probe-fabric --cluster <name> --write` to discover node labels, devices, resources, address type, and rail count. Set RDMA_UCX_TLS for the cluster fabric after discovery.
#
# Comma-separated key=value labels that select RDMA-capable nodes.
# Auto-populated by probe-fabric; or set manually (`kubectl get nodes --show-labels | grep -iE 'rdma|infiniband'`).
RDMA_NODE_SELECTOR=""
# UCX transports for the cluster fabric:
#   InfiniBand  -> "rc,rc_x,dc,dc_x,cuda_copy"   (dc/dc_x = Dynamically Connected, IB-only)
#   RoCE / Eth  -> "rc,rc_x,cuda_copy"           (NO dc/dc_x; DC is not supported on Ethernet devices)
# Empty uses the InfiniBand default. Set this explicitly on RoCE clusters.
RDMA_UCX_TLS="rc,rc_x,dc,dc_x,cuda_copy"
# UCX HCA or NIC names on this cluster.
# "all" lets UCX auto-select but may miss multi-rail IB or pick the wrong interface.
# Auto-populated by probe-fabric from rdma/* node capacity keys. e.g. 8-rail B200:
#   RDMA_UCX_NET_DEVICES="mlx5_0:1,mlx5_1:1,mlx5_2:1,mlx5_3:1,mlx5_4:1,mlx5_5:1,mlx5_10:1,mlx5_11:1"
RDMA_UCX_NET_DEVICES="all"
# Address type for the fabric: "auto" for native InfiniBand; "eth" only for RoCE/Ethernet.
# Auto-populated by probe-fabric (label heuristic); override if the detection is wrong.
# Do not leave this empty for disaggregated workloads; UCX requires a valid address type.
RDMA_UCX_IB_ADDR_TYPE="auto"
# Maximum rails UCX may use for one rendezvous transfer. Empty defaults to 4.
RDMA_UCX_MAX_RNDV_RAILS=""
# Extended resource exposed by the cluster's RDMA device plugin.
# Auto-populated by probe-fabric. e.g. "rdma/ib" (generic) or "rdma/mlx5_0" (per-device plugin).
RDMA_RESOURCE="rdma/ib"

# ----- Cluster capabilities (auto-discovered) ------------------------------
# `llmb-k8s profile init` records these capabilities, and `profile validate` checks them again.
# Most users should leave these values to the setup tools.
#
# No-internet recipes need the DNS and Kubernetes API addresses in their network-policy allowlist. The setup tools populate both values.
NO_INTERNET_DNS_IP=""
NO_INTERNET_KUBE_API_IP=""
# NVLink multicast is used only by compatible multi-GPU recipes. The setup tools record whether the ComputeDomain API and an IMEX claim are available.
#
# Optional provisioning for clusters that permit creation of a ComputeDomain. Run:
#   llmb-k8s profile provision-imex --cluster <name>   [--recipe <cell>] [--dry-run]
# This creates a shared `llmb-imex` ComputeDomain and records its ResourceClaimTemplate. If the namespace lacks permission, the command exits without changing the profile.
# `profile deprovision-imex` removes it.
NVLINK_MULTICAST_IMEX=""
# The ResourceClaimTemplate the ComputeDomain controller generates (set by provision-imex). merge_imex_claim
# references it as the serving pod's channel claim ONLY when NVLINK_MULTICAST_IMEX=provisioned.
IMEX_CLAIM_TEMPLATE=""
