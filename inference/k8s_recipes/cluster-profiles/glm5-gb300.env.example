#
# Example cluster profile for GLM-5 GB300
# Copy this file to glm5-gb300.env and adjust the identity, secrets, storage, IMEX, and fabric values.
# Validate with: scripts/llmb-k8s profile validate --cluster glm5-gb300

# ----- Identity -------------------------------------------------------
CLUSTER="glm5-gb300"
# Required: set this to a namespace you own on the target cluster; this example does not provide one.
NAMESPACE="<your-namespace>"
OWNER="<your-username>"
KUBE_CONTEXT="<your-eks-context>"
# CONNECT_CMD (optional): the EXACT command to (re)connect to this cluster — echoed verbatim by
# `llmb-k8s fleet` and on authentication failures. Set it to the login command for your provider.
CONNECT_CMD="aws eks update-kubeconfig --name <cluster-name> --region <aws-region> --alias <your-eks-context> --profile <aws-profile>"

# ----- GPU scheduling -------------------------------------------------
GPU_PRODUCT="NVIDIA-GB300"
ARCH="arm64"
SCHEDULER_NAME="default-scheduler"

# ----- Image registry -------------------------------------------------
IMAGE_PULL_SECRET="<image-pull-secret>"

# ----- Model / dataset cache — PER-RECIPE (install auto-provisions per recipe) --------
# You name the STORAGE CLASSES; install derives + creates one correctly-shaped PVC per recipe
# (name=<model-slug>-model-cache, namespaced). See cluster-profiles/README.md.
MODEL_CACHE_RWX_CLASS="<rwx-storage-class>"
MODEL_CACHE_RWO_CLASS="<rwo-storage-class>"
MODEL_CACHE_PVC="<model-cache-pvc>"
MODEL_CACHE_SUBPATH="huggingface"

# ----- Secrets --------------------------------------------------------
HF_SECRET="<hugging-face-secret>"

# ----- Bench pod placement -------------------------------------------
BENCH_NODE_SELECTOR="kubernetes.io/arch: arm64"
BENCH_CPU_REQUEST="16"

# ----- Artifacts (per-run bench output) ------------------------------
ARTIFACTS_STORAGE_CLASS="<artifacts-storage-class>"
ARTIFACTS_SIZE="50Gi"

# ----- Control plane (disconnect-resilient `submit`; ReadWriteMany) ---
CONTROL_STORAGE_CLASS="<control-storage-class>"
CONTROL_SIZE="5Gi"

GPU_PER_NODE="4"

# --- nvlink-imex (auto-provisioned by provision-imex) ---
NVLINK_MULTICAST_IMEX="provisioned"
IMEX_CLAIM_TEMPLATE="<imex-claim-template>"

# --- fabric -----------------------------------------------------------
RDMA_NODE_SELECTOR="feature.node.kubernetes.io/rdma.available=true,feature.node.kubernetes.io/rdma.capable=true"
# Validated GLM-5 settings for AWS GB300 RoCE. Do not reuse InfiniBand or B200 fabric values.
RDMA_UCX_TLS="rc,rc_x,cuda_copy,cuda_ipc"
# Replace this placeholder with the comma-separated rocep* devices present on every target GPU node.
RDMA_UCX_NET_DEVICES="<comma-separated-roce-devices>"
RDMA_UCX_IB_ADDR_TYPE="eth"
# This profile is validated with GPU Direct RDMA disabled for GLM-5 KV transfer.
RDMA_UCX_IB_GPU_DIRECT_RDMA="no"
RDMA_UCX_MAX_RNDV_RAILS="8"
NVLINK_P2P="healthy"
NVLINK_P2P_ROUTE_UNHEALTHY="false"
# Set true only after replacing RDMA_UCX_NET_DEVICES with values verified on the target cluster.
RDMA_FABRIC_PROBED="true"
