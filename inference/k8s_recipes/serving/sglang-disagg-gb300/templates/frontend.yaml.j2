# sglang-disagg — Dynamo HTTP frontend for disaggregated SGLang serving (rendered from a cell's recipe.yaml).
# {{ '{{ ... }}' }} = recipe truth (baked at render). ${ ... } = cluster truth (envsubst at launch).
#
# The frontend is the OpenAI-compatible entrypoint: it discovers prefill/decode workers via etcd + NATS
# (rendered by infra.yaml) and routes disaggregated requests to them. It holds NO GPUs. The Service is
# named "{{ envelope.name }}-server" so the shared aiperf bench-Job (serving/aiperf/templates) reaches it
# at http://{{ envelope.name }}-server:8000 with no per-stack special-casing.
{% set _cache_stage = serving.get('model_cache_staging') or {} %}
{% set _stage_host = _cache_stage.get('mode') == 'node-local-versioned-hostpath' %}
{% set _stage_host_path = _cache_stage.get('host_path', '') %}
apiVersion: v1
kind: Service
metadata:
  name: {{ envelope.name }}-server
  namespace: ${NAMESPACE}
  labels: { app.kubernetes.io/managed-by: llmb-recipe, llmb.nvidia.com/served-model: {{ serving.served_model }} }
spec:
  selector: { app: {{ envelope.name }}-frontend }
  ports: [{ port: 8000, targetPort: 8000, name: http }]
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: {{ envelope.name }}-frontend
  namespace: ${NAMESPACE}
  labels: { app.kubernetes.io/managed-by: llmb-recipe, llmb.nvidia.com/served-model: {{ serving.served_model }} }
spec:
  replicas: {{ serving.get('frontend_replicas', 1) }}
  strategy: { type: Recreate }
  selector: { matchLabels: { app: {{ envelope.name }}-frontend } }
  template:
    metadata: { labels: { app: {{ envelope.name }}-frontend, llmb.nvidia.com/recipe: {{ envelope.name }} } }
    spec:
      automountServiceAccountToken: false
      enableServiceLinks: false
      schedulerName: ${SCHEDULER_NAME}
      imagePullSecrets: [{ name: ${IMAGE_PULL_SECRET} }]
{% if _stage_host %}
      # The verify-node-model-cache initContainer and hostPath volume below require the
      # node-local cache prepared by the node-cache DaemonSet, which only runs on GB300 nodes.
      nodeSelector:
        kubernetes.io/arch: arm64
        nvidia.com/gpu.product: ${GPU_PRODUCT}
{% endif %}
{% set _tols = (envelope.get('requires') or {}).get('tolerations') %}
{% if _tols %}
      tolerations:
{% for t in _tols %}
        - { key: {{ t }}, operator: Exists }
{% endfor %}
{% endif %}
{% if _stage_host %}
      # Dynamo 1.3 resolves tokenizer/config metadata from the absolute snapshot path
      # advertised by workers. Verify and mount the same prepared node cache read-only;
      # never mount the shared RWO model-cache PVC in this router.
      initContainers:
        - name: verify-node-model-cache
          image: {{ image_ref }}
          imagePullPolicy: IfNotPresent
          securityContext: { runAsUser: 0 }
          command: ["/bin/bash", "-lc"]
          args:
            - |
              set -euo pipefail
              expected='{{ serving.model_repo }}@{{ serving.model_revision }}'
              actual=$(cat /node-hf-cache/.llmb-cache-ready 2>/dev/null || true)
              test "$actual" = "$expected" || {
                echo "FATAL: node cache is not ready for $expected (marker='$actual')" >&2
                exit 65
              }
              SNAPSHOT=$(python3 -c "from huggingface_hub import snapshot_download; print(snapshot_download(repo_id='{{ serving.model_repo }}', revision='{{ serving.model_revision }}', cache_dir='/node-hf-cache/hub', local_files_only=True))")
              test -s "$SNAPSHOT/config.json"
              shards=$(find -L "$SNAPSHOT" -maxdepth 1 -name '*.safetensors' -type f | wc -l)
              test "$shards" -eq {{ _cache_stage.get("expected_shards", 142) }} || { echo "FATAL: expected {{ _cache_stage.get("expected_shards", 142) }} checkpoint shards, found $shards" >&2; exit 66; }
              echo "NODE_CACHE_VERIFIED node=$NODE_NAME revision={{ serving.model_revision }} shards=$shards"
          env:
            - name: NODE_NAME
              valueFrom: { fieldRef: { fieldPath: spec.nodeName } }
          resources:
            requests: { cpu: "1", memory: 2Gi }
            limits: { cpu: "4", memory: 8Gi }
          volumeMounts:
            - { mountPath: /node-hf-cache, name: versioned-node-model-cache, readOnly: true }
{% endif %}
      containers:
        - name: frontend
          image: {{ image_ref }}
          imagePullPolicy: IfNotPresent
          command: ["/bin/bash", "-lc"]
          args:
            - |
              set -eu
              # High-concurrency profiles can exceed the container default of 1024 open files.
              ulimit -n 524288 || true
{% for cmd in serving.get('frontend_bootstrap_commands', []) %}
              {{ cmd }}
{% endfor %}
              # This frontend only routes HTTP traffic and never mounts the shared RWO weights PVC.
              # In node-cache mode Dynamo 1.3 still needs read-only access to worker-advertised
              # tokenizer/config metadata, supplied by the verified hostPath below.
              exec python3 -m dynamo.frontend --http-port=8000 --enforce-disagg
          ports: [{ containerPort: 8000, name: http, protocol: TCP }]
          env:
            - { name: PYTHONUNBUFFERED, value: "1" }
            - { name: ETCD_ENDPOINTS, value: "http://{{ envelope.name }}-etcd:2379" }
            - { name: NATS_SERVER, value: "nats://{{ envelope.name }}-nats:4222" }
            - { name: DYN_REQUEST_PLANE, value: "nats" }
            - { name: DYN_SKIP_SGLANG_LOG_FORMATTING, value: "1" }
{% if _stage_host %}
            - { name: HF_HOME, value: "/data/hf-cache" }
            - { name: HF_HUB_OFFLINE, value: "1" }
            - { name: TRANSFORMERS_OFFLINE, value: "1" }
{% endif %}
            - name: POD_UID
              valueFrom:
                fieldRef: { fieldPath: metadata.uid }
          startupProbe:
            httpGet: { path: /health, port: http }
            periodSeconds: 10
            timeoutSeconds: 3
            failureThreshold: 180   # 30-min budget: workers must register before the frontend is ready
          readinessProbe:
            httpGet: { path: /health, port: http }
            periodSeconds: 5
            timeoutSeconds: 3
            failureThreshold: 3
          livenessProbe:
            httpGet: { path: /health, port: http }
            periodSeconds: 15
            timeoutSeconds: 5
            failureThreshold: 8
          resources:
            requests: { cpu: "4", memory: 16Gi }
            limits:   { cpu: "16", memory: 64Gi }
{% if _stage_host %}
          volumeMounts:
            - { mountPath: /data/hf-cache, name: versioned-node-model-cache, readOnly: true }
      volumes:
        - name: versioned-node-model-cache
          hostPath:
            path: {{ _stage_host_path | tojson }}
            type: Directory
{% endif %}
