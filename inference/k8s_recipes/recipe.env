# Recipe-intrinsic configuration for the agentic KV-cache offload k8s recipe.
# Tracked in git. Values here are the same on every cluster.
# Cluster-intrinsic knobs live in cluster-profiles/<cluster>.env (gitignored).
#
# What's "recipe-intrinsic" vs. "cluster-intrinsic":
#   Recipe-intrinsic = the benchmark itself. Model + SGLang flags + sweep
#     definition + image refs + AIPerf SHA. Identical on every cluster
#     the recipe runs on — that's how results stay comparable.
#   Cluster-intrinsic = how this cluster exposes resources. Namespace,
#     RWX cache PVC name, RWO storage class, GPU count, tolerations.
#     Lives in cluster-profiles/<cluster>.env (and chart values mirror).
#
# A few values below are technically recipe-intrinsic but are sized for
# the GB200 reference node SKU. If your cluster has a different GPU SKU
# you may need to tune SERVER_MEM_REQUEST / SERVER_MEM_LIMIT downward.
# Each such knob is annotated inline.

# ----- Recipe identity -----------------------------------------------------
RECIPE_SHORTNAME="llmb-benchmark"

# ----- Model ---------------------------------------------------------------
# HuggingFace repo id and an optional pinned revision (commit SHA or branch).
# Pin revisions so model and tokenizer inputs remain reproducible. Update them deliberately.
MODEL_NAME="nvidia/NVIDIA-Nemotron-3-Ultra-550B-A55B-NVFP4"
SERVED_MODEL_NAME="nemotron-ultra-3"
MODEL_REVISION="183968f87ae4cedce3039313cac1fd43d112c578"  # pinned model snapshot
# HF cache layout on disk under HF_HOME: hub/models--<org>--<name>/snapshots/<sha>/
MODEL_HF_DIR="models--nvidia--NVIDIA-Nemotron-3-Ultra-550B-A55B-NVFP4"
# Optional source/destination subpaths inside MODEL_CACHE_PVC. When
# MODEL_SOURCE_CACHE_SUBPATH is non-empty, the model Job seeds our
# recipe-owned MODEL_CACHE_SUBPATH from that existing cache instead of
# downloading from HuggingFace.
MODEL_CACHE_SUBPATH="llmb-benchmark-nemotron-ultra-3/huggingface"
MODEL_SOURCE_CACHE_SUBPATH=""
MODEL_SERVER_CACHE_MOUNT="/data/hf-cache"

# ----- Dataset -------------------------------------------------------------
# Current path: synthetic long-context distribution generated with
# a trace-generation workflow and replayed as a Mooncake trace.
#
# Private-repository fallback:
#   DATASET_REPO="<dataset-repository>"
#   DATASET_TYPE="weka_trace"
#   DATASET_SUBPATH="datasets/agentic_coding"
#   AIPERF_SCENARIO="inferencex-agentx-mvp"
#   AIPERF_EXTRA_INPUTS=""
#   NUM_DATASET_ENTRIES=267
#   CACHE_BUST="first_turn_prefix"
DATASET_REPO=""
# Optional revision pin (commit SHA or branch). Without this the dataset
# download Job pulls whatever the repo's default branch currently points
# at, which makes the recipe non-reproducible the moment the upstream
# updates the dataset. Behaviour:
#   - Empty (default for now): no `--revision` passed to `hf download`;
#     equivalent to "pull current default-branch tip" — backward
#     compatible with runs taken before this knob existed.
#   - Non-empty: passed as `hf download ... --revision "$DATASET_REVISION"`.
# TODO(operator): populate with the current default-branch commit SHA of
# the configured dataset repository (run `huggingface-cli scan-cache` on a known-good
# `_shared/inputs.json` or `git ls-remote` the dataset repo) so the recipe
# is pinned end-to-end.
DATASET_REVISION=""
# Relative to MODEL_CACHE_MOUNT in the cluster profile.
DATASET_TYPE="mooncake_trace"
# WARNING: this is the NON-CANONICAL 2000-session dataset used by the manual dynamo-disagg
# path only. The per-cell recipe.yaml files pin the canonical 500-session traces under
# datasets/example-long-context-{256k,1m}/. Do NOT use this path
# for published benchmark runs — results will not be comparable with recipe.yaml cells.
DATASET_SUBPATH="datasets/example-long-context-trace/dataset.jsonl"
DATASET_CONFIG_PATH="datasets/example-long-context-trace.json"
DATASET_NUM_SESSIONS=2000
DATASET_SEED=42
# v2 (2026-07-10): cap the cISL tail at the intended context ceiling (~1.024M) instead
# of the prior 1.048M/1.35M over-extrapolation. See datasets/example-long-context-trace.json.
DATASET_MAX_ISL=1024000

# ----- Container images ----------------------------------------------------
SGLANG_IMAGE="nvcr.io/nvidia/ai-dynamo/vllm-runtime@sha256:9fefbd10b63c52030326e22ed0eb9d87082fee53709fe327b5b2773e267792bc"
DOWNLOAD_IMAGE="python:3.10-slim"
BENCH_IMAGE="python:3.12-slim"
# Image used by scripts/fetch_results.sh and verify-cluster.sh for transient pods.
UTIL_IMAGE="busybox:1.36"
# Image with kubectl for the bench Job's server-restart guard.
KUBECTL_IMAGE="bitnami/kubectl:1.34"

# ----- Server config -------------------------------------------------------
SERVER_RUNTIME="vllm"
TP_SIZE=8
CONTEXT_LENGTH=1048576
MEM_FRACTION_STATIC=0.30
HICACHE_RATIO=2.0
HICACHE_WRITE_POLICY="write_through_selective"
HICACHE_IO_BACKEND="kernel"
# vLLM CPU-side cache/offload knobs. `VLLM_KV_OFFLOADING_SIZE` is GiB total
# across all TP ranks; non-empty/non-zero enables vLLM native CPU KV offload.
# Keep it disabled for Nemotron Ultra on vLLM 0.20.1: the OffloadingConnector
# currently rejects the model's hybrid KV-cache layout.
# `VLLM_CPU_OFFLOAD_GB` is model weight offload per GPU, left disabled because
# it can add forward-pass latency and Nemotron fits this B200 profile without it.
VLLM_KV_OFFLOADING_SIZE="0"
VLLM_KV_OFFLOADING_BACKEND="native"
# Select the SupportsHMA SimpleCPUOffloadConnector (1) instead of the default
# non-HMA OffloadingConnector (0). The simple connector offloads the hybrid
# Mamba+attention cache with HMA left ON; required for Nemotron. Needs
# VLLM_KV_OFFLOADING_SIZE>0 + backend=native to take effect.
VLLM_USE_SIMPLE_KV_OFFLOAD="0"
VLLM_CPU_OFFLOAD_GB="0"
VLLM_ALLOW_LONG_MAX_MODEL_LEN="1"
PYTORCH_CUDA_ALLOC_CONF="expandable_segments:True"
VLLM_GPU_MEMORY_UTILIZATION="0.85"
# vLLM scheduling knobs. Keep context length independent from the active
# sequence cap. The high-context profile is KV-bound by the 585k-1M tail;
# standalone canaries on B200 validated 16k chunked-prefill with 200k and
# 600k prompt completions.
# Set to the max sweep concurrency so the server admits the full offered load
# (max-num-seqs below the tested concurrency caps admission and inflates TTFT,
# making the ceiling a server artifact instead of a real KV/compute limit).
VLLM_MAX_NUM_SEQS=256
VLLM_MAX_NUM_BATCHED_TOKENS=16384
# YaRN rope scaling for >32k context (Qwen3 base trains at 32k).
ROPE_SCALING_JSON='{"rope_scaling":{"rope_type":"yarn","factor":4.0,"original_max_position_embeddings":32768}}'

# Server pod resource governance.
#
# Memory: sized for the B200/Nemotron vLLM profile. The 256 GB CPU KV
# offload buffer is ~238 GiB before runtime overhead, so request==limit
# at 600Gi avoids scheduler overcommit for memory during the multi-hour
# sweep. Full Guaranteed QoS would also require CPU request==limit. On
# smaller nodes, reduce VLLM_KV_OFFLOADING_SIZE and these memory values
# together. The legacy SGLang HiCache path may instead need
# HICACHE_RATIO tuned down.
SERVER_CPU_REQUEST="32"
SERVER_CPU_LIMIT="96"
SERVER_MEM_REQUEST="600Gi"
SERVER_MEM_LIMIT="600Gi"

# Optional server-only cluster taint toleration for the envsubst frontend.
# Leave empty unless the target cluster profile explicitly opts into a
# reserved GPU pool.
SERVER_EXTRA_TOLERATION_KEY=""
SERVER_EXTRA_TOLERATION_VALUE=""
SERVER_EXTRA_TOLERATION_EFFECT="NoSchedule"

# Optional bench-only cluster taint tolerations for the envsubst frontend.
# Leave empty unless CPU nodes are saturated and the target profile
# explicitly permits the CPU-only AIPerf client on tainted GPU nodes.
BENCH_EXTRA_TOLERATION_KEY=""
BENCH_EXTRA_TOLERATION_VALUE=""
BENCH_EXTRA_TOLERATION_EFFECT="NoSchedule"
BENCH_EXTRA_TOLERATION2_KEY=""
BENCH_EXTRA_TOLERATION2_VALUE=""
BENCH_EXTRA_TOLERATION2_EFFECT="NoSchedule"

# ----- GPU telemetry -------------------------------------------------------
# Per-GPU power/util/mem/clocks time-series (gpu_stats.csv), used for
# perf/watt. The bench Pod is CPU-only, so telemetry is captured FROM the
# GPU-bearing server side. Modes:
#   auto  (default) prefer DCGM_EXPORTER_URL if set, else exec nvidia-smi
#                   in the server Pod (needs pods/exec RBAC, granted by the
#                   bench Role).
#   exec            force `kubectl exec` of nvidia-smi in the server Pod.
#   dcgm            force scraping a DCGM-exporter Prometheus endpoint.
#   off             disable GPU telemetry entirely.
# A one-shot preflight self-test writes gpu_stats.status (and logs to the
# Job) BEFORE the sweep so an empty capture is caught immediately, not after
# the run. See TROUBLESHOOTING.md ("GPU telemetry gpu_stats.csv is empty").
GPU_TELEMETRY="auto"
# Server container name to exec into (matches the server Pod's container). If
# it doesn't match, the scrape falls back to the Pod's default container.
SERVER_CONTAINER="sglang"
# DCGM-exporter metrics URL for GPU telemetry on clusters that forbid exec
# into application containers, your cluster's DCGM exporter metrics endpoint
# Empty disables the DCGM path.
DCGM_EXPORTER_URL=""

# ----- Benchmark (AIPerf) --------------------------------------------------
# Immutable AIPerf revision used by the benchmark container.
AIPERF_REF="git+https://github.com/ai-dynamo/aiperf.git@fef78a96ee30df4c135a9e5691b48e50ba91133d"
AIPERF_SCENARIO=""
AIPERF_EXTRA_INPUTS="ignore_eos:true"
# AIPerf HTTP connection reuse. Sticky sessions reduce connection churn under load.
# Empty omits the flag (AIPerf default). Set to a valid AIPerf strategy name
# to override (e.g. `sticky-user-sessions`, `least-recently-used`).
CONNECTION_REUSE_STRATEGY="sticky-user-sessions"
# Empty CONCURRENCIES enables the adaptive sweep below. Set a non-empty
# space-separated list to preserve the original fixed-list behavior and
# skip all adaptive stop/refinement logic.
CONCURRENCIES="32 64 96 128 192 256"
CONCURRENCY_START=16
CONCURRENCY_MULTIPLIER=2
CONCURRENCY_MAX=512
TTFT_LIMIT_MS=10000
TPOT_LIMIT_MS=100
STOP_STAT="p50"
BINARY_SEARCH=true
BINARY_SEARCH_MAX_STEPS=4
BINARY_SEARCH_MIN_GAP=16
REFINE_LOWER_FRAC=0.85
REFINE_UPPER_FRAC=1.15
# ----- Workload sizing --------------------------------------------------
# Workload mode (priority): REQUEST_COUNT_MULTIPLIER>0 -> fixed request-count =
# multiplier x concurrency (synthetic datasets only; IGNORED by mooncake
# fixed_schedule replay); else BENCH_DURATION>0 -> fixed duration + ramp/grace;
# else FULL-TRACE REPLAY -- every rung replays the entire dataset, so the
# cISL/nISL/OSL work distribution is identical across concurrencies and only the
# work-rate changes. Full-replay is the correct comparable mode for mooncake;
# bound per-rung wall time via the dataset's num-sessions (see serving/vllm-aggregated/contexts/*.env).
REQUEST_COUNT_MULTIPLIER=""
BENCH_DURATION=""
# Excluded warmup requests before measurement = multiplier x concurrency
# (the ramp-up). Applies in every mode. Empty/0 disables the warmup phase.
WARMUP_REQUEST_MULTIPLIER=1
# ramp / grace apply only in duration mode (BENCH_DURATION set).
CONCURRENCY_RAMP_DURATION=600
BENCHMARK_GRACE_PERIOD=1800
# AIPerf per-request timeout. Choose a value that allows the configured long-context workload to complete.
REQUEST_TIMEOUT_SECONDS=3600
PRE_SWEEP_SMOKE_PROMPT_TOKENS=600000
PRE_SWEEP_SMOKE_TIMEOUT_SECONDS=1200
# Empty omits --num-dataset-entries; trace replay then counts rows from dataset.jsonl.
NUM_DATASET_ENTRIES=""
NUM_PROFILE_RUNS=1
# Empty omits --cache-bust. Mooncake replay uses fixed_schedule timing;
# first_turn_prefix is only valid with the legacy agentic_replay scenario.
CACHE_BUST=""
# Clean /artifacts/$RUN_ID at benchmark Job start. Set false only for an
# intentional same-run resume after preserving completed concurrency dirs.
CLEAN_ARTIFACTS_ROOT=true

# Bench Job resource governance (no GPU; CPU-bound HTTP client).
BENCH_CPU_REQUEST="16"
BENCH_CPU_LIMIT="32"
BENCH_MEM_REQUEST="16Gi"
BENCH_MEM_LIMIT="32Gi"

# ----- Local output --------------------------------------------------------
RESULTS_LOCAL_DIR="./results"
